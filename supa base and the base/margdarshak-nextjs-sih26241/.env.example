# ============================================================================
# MARGDARSHAK (SIH26241 - MSDE) ENVIRONMENT VARIABLES
# Never commit .env or .env.local to version control.
# Validated at server startup via Zod in lib/security/env.ts
# ============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"

# AI Provider Configuration (Server-Side Only)
AI_PROVIDER="gemini" # Supported: "gemini" | "openai" | "anthropic"
AI_API_KEY="your-llm-api-key"
AI_MODEL_NAME="gemini-2.5-flash"
AI_EMBEDDING_MODEL="text-embedding-004"

# Security & Encryption Keys (Server-Side Only)
# 32-byte hex key for AES-256-GCM encryption of CounsellorRequest contact fields
CONTACT_ENCRYPTION_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
CSRF_SECRET="your-random-32-char-csrf-secret-key"

# Privacy & Retention Policy
CONVERSATION_RETENTION_DAYS="30"
MIN_K_ANONYMITY_THRESHOLD="5"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
